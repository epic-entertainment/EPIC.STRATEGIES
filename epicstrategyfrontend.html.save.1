<!DOCTYPE html>
<html>
<head>

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<style>

body{
  margin:0;
  background:#1b1b1b;
  color:white;
  font-family:Arial,sans-serif;
  overflow:hidden;

  background-image:
    url("assets/backgrounds/11.png");

  

#app{
  display:flex;
  flex-direction:column;
  align-items:center;

  width:100vw;
  height:100vh;

  padding:10px;
  box-sizing:border-box;
}

h1{
  margin:5px 0;
  font-size:28px;
}

.menu-button{
  width:90%;
  max-width:320px;

  padding:14px;
  margin:8px 0;

  font-size:18px;

  border:none;
  border-radius:10px;

  background:#3f8f3f;
  color:white;
}

/* PAGES */

.page{
  width:100%;
  text-align:center;
}

#gamePage{
  width:100%;
  flex:1;
  display:flex;
  flex-direction:column;
}

#boardWrapper{

  width:100%;
  flex:1;

  overflow:auto;

  border:2px solid rgba(255,255,255,0.2);

  background:rgba(0,0,0,0.15);

  touch-action:none;

  -webkit-overflow-scrolling:touch;
}

#board{

  display:grid;

  grid-template-columns:
    repeat(30,22px);

  grid-template-rows:
    repeat(30,22px);

  width:max-content;
  height:max-content;
}

.cell{

  width:22px;
  height:22px;

  background:#d2a679;

  border:1px solid rgba(0,0,0,0.1);

  box-sizing:border-box;
}

.preview{
  outline:2px solid red;
}

#status{
  margin:8px 0;
  font-size:18px;
}

#donate{
  position:fixed;

  bottom:4px;
  left:0;

  width:100%;

  text-align:center;

  font-size:10px;

  opacity:0.7;
}

#donate a{
  color:#aaa;
  text-decoration:none;
}

</style>

</head>

<body>

<div id="app">

  <!-- MENU -->

  <div id="menu" class="page">

    <h1>EPIC STRATEGIES</h1>

    <button class="menu-button"
      onclick="showPage('playMenu')">

      PLAY

    </button>

    <button class="menu-button"
      onclick="showPage('cluePage')">

      GET A CLUE

    </button>

    <button class="menu-button"
      onclick="showPage('howTo')">

      HOW TO PLAY

    </button>

  </div>

  <!-- PLAY MENU -->

  <div id="playMenu"
       class="page"
       style="display:none;">

    <h1>Select Mode</h1>

    <button class="menu-button"
      onclick="startGame(2)">

      2 Players (Connect 5)

    </button>

    <button class="menu-button"
      onclick="startGame(3)">

      3 Players (Connect 4)

    </button>

    <button class="menu-button"
      onclick="startGame(4)">

      4 Players (Connect 3)

    </button>

    <button class="menu-button"
      onclick="showPage('menu')">

      BACK

    </button>

  </div>

  <!-- GAME -->

  <div id="gamePage"
       class="page"
       style="display:none;">

    <div id="status">
      Waiting...
    </div>

    <button class="menu-button"
      onclick="showPage('menu')">

      EXIT

    </button>

    <div id="boardWrapper">
      <div id="board"></div>
    </div>

  </div>

  <!-- CLUES -->

  <div id="cluePage"
       class="page"
       style="display:none;">

    <h1>Get Clues</h1>

    <button class="menu-button"
      onclick="watchAd()">

      WATCH AD (+2 CLUES)

    </button>

    <div id="clues">
      Clues: 0
    </div>

    <button class="menu-button"
      onclick="showPage('menu')">

      BACK

    </button>

  </div>

  <!-- HOW TO -->

  <div id="howTo"
       class="page"
       style="display:none;">

    <h1>How To Play</h1>

    <p>2 Players → Connect 5</p>
    <p>3 Players → Connect 4</p>
    <p>4 Players → Connect 3</p>

    <p>
      Players inactive for 3 minutes
      may be skipped.
    </p>

    <button class="menu-button"
      onclick="showPage('menu')">

      BACK

    </button>

  </div>

</div>

<div id="donate">
  <a href="#" onclick="openDonate()">
    adopt a dev
  </a>
</div>

<script>

const API =
"https://epic-strategies.onrender.com";

let gameId = null;

let currentPlayer = "p1";

let players = [];

let clues = 0;

let previewCell = null;

/* PAGE NAV */

function showPage(page){

  [
    "menu",
    "playMenu",
    "gamePage",
    "cluePage",
    "howTo"
  ].forEach(id=>{

    document.getElementById(id)
      .style.display = "none";
  });

  document.getElementById(page)
    .style.display = "block";
}

/* START GAME */

function startGame(count){

  showPage("gamePage");

  createGame(count);
}

/* CREATE GAME */

async function createGame(count){

  const map = {

    2:["p1","p2"],

    3:["p1","p2","p3"],

    4:["p1","p2","p3","p4"]
  };

  players = map[count];

  currentPlayer = players[0];

  const res =
    await fetch(API+"/games",{

    method:"POST",

    headers:{
      "Content-Type":"application/json"
    },

    body:JSON.stringify(players)
  });

  const data = await res.json();

  gameId = data.game_id;

  renderBoard(data.board);

  document.getElementById("status")
    .innerText =
      "Turn: " + currentPlayer;
}

/* RENDER BOARD */

function renderBoard(board){

  const boardDiv =
    document.getElementById("board");

  boardDiv.innerHTML = "";

  board.forEach((row,y)=>{

    row.forEach((cell,x)=>{

      const div =
        document.createElement("div");

      div.className = "cell";

      if(cell){

        div.style.background =

          cell==="p1" ? "black" :

          cell==="p2" ? "white" :

          cell==="p3" ? "blue" :

          "green";
      }

      div.dataset.x = x;
      div.dataset.y = y;

      div.addEventListener(
        "touchstart",
        ()=>previewMove(div)
      );

      div.addEventListener(
        "touchmove",
        ()=>previewMove(div)
      );

      div.addEventListener(
        "touchend",
        ()=>makeMove(x,y)
      );

      div.onclick =
        ()=>makeMove(x,y);

      boardDiv.appendChild(div);
    });
  });
}

/* PREVIEW */

function previewMove(div){

  if(previewCell){
    previewCell.classList.remove(
      "preview"
    );
  }

  previewCell = div;

  previewCell.classList.add(
    "preview"
  );
}

/* MOVE */

async function makeMove(x,y){

  if(!gameId) return;

  const res =
    await fetch(API+"/move",{

    method:"POST",

    headers:{
      "Content-Type":"application/json"
    },

    body:JSON.stringify({

      game_id:gameId,

      player:currentPlayer,

      x,y
    })
  });

  if(!res.ok) return;

  const data = await res.json();

  renderBoard(data.board);

  if(data.winner){

    document.getElementById("status")
      .innerText =
        "Winner: " + data.winner;

    return;
  }

  currentPlayer =
    data.next_turn;

  document.getElementById("status")
    .innerText =
      "Turn: " + currentPlayer;
}

/* CLUES */

function watchAd(){

  alert("Simulated rewarded ad");

  setTimeout(()=>{

    clues += 2;

    document.getElementById("clues")
      .innerText =
        "Clues: " + clues;

  },1000);
}

function openDonate(){

  window.open(
    "https://buymeacoffee.com",
    "_blank"
  );
}

</script>

</body>
</html>
