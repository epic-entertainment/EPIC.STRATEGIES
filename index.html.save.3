<!DOCTYPE html>
<html>
<head>

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #d9d9d9;
  display: flex;
  justify-content: center;
}

#app {
  width: 100%;
  max-width: 480px;
  padding: 16px;
  box-sizing: border-box;
}

/* SCREENS */
.screen {
  display: none;
}

.screen.active {
  display: block;
}

/* TITLE */
h1 {
  text-align: center;
  font-size: clamp(24px, 6vw, 36px);
  margin-bottom: 20px;
}

/* BUTTONS */
.button {
  width: 100%;
  padding: 16px;
  margin: 10px 0;
  font-size: clamp(16px, 4vw, 22px);
  border-radius: 12px;
  border: none;
  background: linear-gradient(#1e1e1e, #111);
  color: white;
  cursor: pointer;
}

.button:active {
  transform: scale(0.97);
}
</style>

</head>

<body>

<style>
  body {
    margin: 0;
    background: #1b1b1b;
    color: white;
    font-family: Arial, sans-serif;
    overflow: hidden;
  }

  #app {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100vh;
    padding: 10px;
    box-sizing: border-box;
  }

  h1 {
    margin: 5px 0;
    font-size: 28px;
  }

  .menu-button {
    width: 90%;
    max-width: 320px;
    padding: 14px;
    margin: 8px 0;
    font-size: 18px;
    border: none;
    border-radius: 10px;
    background: #3f8f3f;
    color: white;
  }

  #boardWrapper {
    overflow: auto;
    touch-action: none;
    border: 2px solid #555;
    max-width: 100%;
    max-height: 75vh;
    background: #7a5a34;
  }

  #board {
    display: grid;
    grid-template-columns: repeat(30, 24px);
    grid-template-rows: repeat(30, 24px);
    transform-origin: top left;
  }

  .cell {
    width: 24px;
    height: 24px;
    background: #d2a679;
    border: 1px solid rgba(0,0,0,0.15);
    box-sizing: border-box;
  }

  .topbar {
    display: flex;
    gap: 8px;
    margin: 6px 0;
  }

  .zoom-btn {
    padding: 10px 14px;
    font-size: 18px;
    border: none;
    border-radius: 8px;
    background: #444;
    color: white;
  }

  #status {
    margin: 6px 0;
    font-size: 18px;
  }

  #donate {
    position: fixed;
    bottom: 4px;
    left: 0;
    width: 100%;
    text-align: center;
    font-size: 10px;
    opacity: 0.7;
  }

  #donate a {
    color: #aaa;
    text-decoration: none;
  }

</style>

<div id="app">

  <!-- MAIN MENU -->
  <div id="menu">
    <h1>GOMOKU</h1>

    <button class="menu-button" onclick="showPage('playMenu')">
      PLAY
    </button>

    <button class="menu-button" onclick="showPage('cluePage')">
      GET A CLUE
    </button>

    <button class="menu-button" onclick="showPage('howTo')">
      HOW TO PLAY
    </button>
  </div>

  <!-- PLAY MENU -->
  <div id="playMenu" style="display:none;">
    <h1>Select Mode</h1>

    <button class="menu-button" onclick="startGame(2)">
      2 Players (Connect 5)
    </button>

    <button class="menu-button" onclick="startGame(3)">
      3 Players (Connect 4)
    </button>

    <button class="menu-button" onclick="startGame(4)">
      4 Players (Connect 3)
    </button>

    <button class="menu-button" onclick="showPage('menu')">
      BACK
    </button>
  </div>

  <!-- GAME PAGE -->
  <div id="gamePage" style="display:none; width:100%;">

    <div id="status">Waiting...</div>

    <div class="topbar">
      <button class="zoom-btn" onclick="zoomOut()">-</button>
      <button class="zoom-btn" onclick="zoomIn()">+</button>
      <button class="zoom-btn" onclick="showPage('menu')">EXIT</button>
    </div>

    <div id="boardWrapper">
      <div id="board"></div>
    </div>

  </div>

  <!-- CLUE PAGE -->
  <div id="cluePage" style="display:none;">
    <h1>Get Clues</h1>

    <button class="menu-button" onclick="watchAd()">
      WATCH AD (+2 CLUES)
    </button>

    <div id="clues">Clues: 0</div>

    <button class="menu-button" onclick="showPage('menu')">
      BACK
    </button>
  </div>

  <!-- HOW TO -->
  <div id="howTo" style="display:none;">
    <h1>How To Play</h1>

    <p>2 Players → Connect 5</p>
    <p>3 Players → Connect 4</p>
    <p>4 Players → Connect 3</p>

    <p>
      If a player takes longer than 3 minutes,
      their turn is skipped.
    </p>

    <button class="menu-button" onclick="showPage('menu')">
      BACK
    </button>
  </div>

</div>

<div id="donate">
  <a href="#">Adopt a Dev</a>
</div>

<script>

const API = "";

let gameId = null;
let currentPlayer = "p1";
let players = [];
let zoom = 1;
let clues = 0;

/* PAGE NAV */

function showPage(page){
  ["menu","playMenu","gamePage","cluePage","howTo"]
    .forEach(id=>{
      document.getElementById(id).style.display="none";
    });

  document.getElementById(page).style.display="block";
}

/* ZOOM */

function applyZoom(){
  document.getElementById("board").style.transform =
    `scale(${zoom})`;
}

function zoomIn(){
  zoom += 0.1;
  applyZoom();
}

function zoomOut(){
  zoom = Math.max(0.5, zoom - 0.1);
  applyZoom();
}

/* START GAME */

function startGame(count){
  showPage("gamePage");
  createGame(count);
}

/* CREATE GAME */

async function createGame(count){

  const map = {
    2:["p1","p2"],
    3:["p1","p2","p3"],
    4:["p1","p2","p3","p4"]
  };

  players = map[count];
  currentPlayer = players[0];

  const res = await fetch(API+"/games",{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify(players)
  });

  const data = await res.json();

  gameId = data.game_id;

  renderBoard(data.board);

  document.getElementById("status").innerText =
    "Turn: " + currentPlayer;
}

/* BOARD */

function renderBoard(board){

  const boardDiv = document.getElementById("board");

  boardDiv.innerHTML = "";

  board.forEach((row,y)=>{

    row.forEach((cell,x)=>{

      const div = document.createElement("div");

      div.className = "cell";

      if(cell){
        div.style.background =
          cell==="p1" ? "black" :
          cell==="p2" ? "white" :
          cell==="p3" ? "blue" :
          "green";
      }

      div.onclick = ()=>makeMove(x,y);

      boardDiv.appendChild(div);

    });

  });

}

/* MOVE */

async function makeMove(x,y){

  if(!gameId) return;

  const res = await fetch(API+"/move",{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({
      game_id:gameId,
      player:currentPlayer,
      x,y
    })
  });

  if(!res.ok) return;

  const data = await res.json();

  renderBoard(data.board);

  if(data.winner){
    document.getElementById("status").innerText =
      "Winner: " + data.winner;
    return;
  }

  currentPlayer = data.next_turn;

  document.getElementById("status").innerText =
    "Turn: " + currentPlayer;

}

/* CLUES */

function watchAd(){

  alert("Simulated rewarded ad");

  setTimeout(()=>{

    clues += 2;

    document.getElementById("clues").innerText =
      "Clues: " + clues;

  },1000);

}

</script>

</body>
</html>
